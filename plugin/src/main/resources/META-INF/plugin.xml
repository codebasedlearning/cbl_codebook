<idea-plugin>
    <id>dev.codebasedlearning.codebook</id>
    <name>Codebook</name>
    <vendor email="info@codebasedlearning.dev" url="https://www.codebasedlearning.dev">codebasedlearning</vendor>

    <description><![CDATA[
        This is a JetBrains IDE plugin for teaching and learning programming at a code
        level. <p>
        The plugin converts didactic comments in code snippets into a structured side panel
        and folds them away in the editor, ensuring the code remains readable while the
        prose remains accessible. <br>
        The side panel also provides access to further information, such as glossary entries
        or answers to questions. This helps to focus on the discussion at hand while
        simultaneously providing access to additional resources.
        <br/><br/>
        See README for details.
    ]]></description>

    <!-- No <change-notes> here on purpose: it is GENERATED from CHANGELOG.md
         by the org.jetbrains.changelog Gradle plugin (see build.gradle.kts).
         One source of truth; the patched file lands in build/patchedPluginXml/. -->

    <!-- Works in CLion, PyCharm, IntelliJ IDEA, ... - no language-specific API. -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Markdown rendering of the notes: the org.jetbrains:markdown library ships
         inside this bundled plugin, so we use the IDE's copy instead of packing a
         second one (Plugin Verifier: "Plugin bundles IDE packages"). Bundled in
         every IntelliJ-based IDE; Codebook is disabled if a user disables it. -->
    <depends>org.intellij.plugins.markdown</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Codebook"
                    anchor="right"
                    icon="/icons/cblToolWindow.svg"
                    factoryClass="dev.codebasedlearning.cbl.CblToolWindowFactory"/>
        <postStartupActivity implementation="dev.codebasedlearning.cbl.CblStartup"/>
        <notificationGroup id="Codebook" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
